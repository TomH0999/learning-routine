{
  "name": "learning-routine",
  "productName": "Routine d'apprentissage",
  "version": "1.1.0",
  "description": "Routine d'apprentissage (version PC)",
  "main": "main.js",
  "author": "TomH0999",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis --publish never" },
  "devDependencies": { "electron": "33.2.1", "electron-builder": "25.1.8" },
  "build": {
    "appId": "io.github.tomh0999.learningroutine",
    "files": ["main.js", "app/**"],
    "win": { "target": "nsis", "icon": "app/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "artifactName": "Routine-Setup-${version}.${ext}"
  }
}

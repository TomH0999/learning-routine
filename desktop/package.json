{
  "name": "learning-routine",
  "productName": "Routine d'apprentissage",
  "version": "1.9.0",
  "description": "Routine d'apprentissage (version PC)",
  "main": "main.js",
  "author": "TomH0999",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.tomh0999.learningroutine",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico",
      "app/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "shortcutName": "Routine"
    },
    "artifactName": "Routine-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "TomH0999",
        "repo": "learning-routine",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}